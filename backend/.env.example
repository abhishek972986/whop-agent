# Apify - scrapes the Whop marketplace
APIFY_TOKEN=your_apify_token

# Build-time only: reuse the first scrape on refresh so UI work costs no Apify runs.
# Delete this line (or set false) for a live scrape on every Browse marketplace click.
DEV_CACHE=true

# ---------------------------------------------------------------------------
# Protects each user's stored mailbox password (AES-256-GCM). REQUIRED.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing or changing it makes stored mailboxes unreadable - users simply
# reconnect. Never commit it.
# ---------------------------------------------------------------------------
ENCRYPTION_KEY=64_hex_characters

# ---------------------------------------------------------------------------
# Gmail - OPTIONAL now. Each user connects their own mailbox in the app,
# so these are only used by a single-user self-hosted copy.
#
#   1. Turn on 2-Step Verification on your Google account
#   2. myaccount.google.com -> Security -> App passwords -> generate one for "Mail"
#   3. Paste the 16-character password below (spaces are stripped automatically)
#   4. Restart the server - .env is only read at startup
#
# Verify with:  npm run mail:test you@gmail.com
# ---------------------------------------------------------------------------
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=your16charapppassword

# Where the newsletter banner images are reachable from.
# localhost is fine for previews, but recipients will see broken images -
# set this to a public host before sending for real.
# PUBLIC_URL=https://your-host.example.com
